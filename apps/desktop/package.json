{
  "name": "@isac-erp/desktop",
  "version": "0.0.0",
  "description": "Application de gestion scolaire ISAC ERP",
  "author": "ISAC",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepare:server-bundle": "node scripts/prepare-server-bundle.mjs",
    "build:unpack": "pnpm prepare:server-bundle && electron-vite build && electron-builder --dir",
    "dist:win": "pnpm --filter @isac-erp/shared build && pnpm prepare:server-bundle && electron-vite build && electron-builder --win",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@isac-erp/api": "workspace:*",
    "@isac-erp/shared": "workspace:*",
    "@isac-erp/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^3.10.1",
    "superjson": "^2.2.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
