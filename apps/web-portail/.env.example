# Développement local : laisser vide pour utiliser automatiquement
# http://localhost:4310/trpc (ou l'adresse LAN du portail).
#
# Déploiement Netlify : renseigner l'URL HTTPS publique de l'API locale,
# obtenue par exemple via un tunnel sécurisé. Cette valeur est publique :
# elle ne doit contenir aucun mot de passe ni clé secrète.
# NEXT_PUBLIC_PORTAL_API_URL=https://api.votre-domaine.tld/trpc

